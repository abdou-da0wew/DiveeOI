# DiveeOI unified environment configuration. Copy to .env and adjust for your setup.
# Values in this file are read by the server and, where noted, the Vite dev proxy.

# ── Server ───────────────────────────────────────────────────────────────
PORT=4097
HOST=0.0.0.0

# Additional browser origins when the UI is hosted separately (comma-separated).
# The development app normally uses the same-origin Vite proxy, so CORS is not
# required for that setup.
CORS=

# Authentication modes: both (default), basic, jwt, disabled.
# `disabled` disables all authentication and is not recommended.
DIVEEOI_AUTH_MODE=both

# Basic credentials. The username defaults to DIVEEOI.
# Non-production, non-test server runs default to DIVEEOI / divee when no
# password is configured. Production has no default Basic password; set a
# strong unique secret if Basic auth is desired. JWT accounts remain enabled
# in the default `both` mode.
# DIVEEOI_SERVER_USERNAME=DIVEEOI
# DIVEEOI_SERVER_PASSWORD=replace-with-a-strong-unique-secret

# JWT signing secret: use a stable random value of at least 32 characters in
# production. When omitted, DiveeOI creates a random key in the persistent data
# directory and restricts its file permissions. Back up the data directory.
# DIVEEOI_JWT_SECRET=replace-with-at-least-32-random-characters

# Registration is closed after the first account unless explicitly enabled.
# Set to 1, true, or yes to allow subsequent registrations (new accounts are
# regular users, not admins).
# DIVEEOI_AUTH_ALLOW_REGISTRATION=0

# OPENCODE_SERVER_USERNAME / OPENCODE_SERVER_PASSWORD remain as legacy
# fallbacks; DIVEEOI_* values take precedence. Do not set both unless migrating.

# ── Web App development proxy ─────────────────────────────────────────────
# Vite proxies recognized API paths to this server. The browser only talks to
# the app origin; server credentials are requested in the styled login form
# and kept in memory, never embedded into the frontend bundle.
VITE_DIVEEOI_SERVER_HOST=127.0.0.1
VITE_DIVEEOI_SERVER_PORT=4097
# Optional complete proxy target; overrides VITE_DIVEEOI_SERVER_HOST/PORT.
# VITE_DIVEEOI_SERVER_URL=http://127.0.0.1:4097
