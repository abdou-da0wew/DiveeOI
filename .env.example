# ── DiveeOI Unified Environment Configuration ──
# Copy this file to .env and adjust values for your setup.
# This file is read by both the server (bun) and the app (Vite).


# ── Server ────────────────────────────────────────

# Port for the DiveeOI API server (default: 4097)
PORT=4097

# Host to bind the server to (default: 0.0.0.0)
HOST=0.0.0.0

# Comma-separated list of additional CORS origins.
# Private network ranges (10.x, 172.16-31.x, 192.168.x, 100.64-127.x/Tailscale)
# are allowed by default. Add custom origins if the app is behind a proxy.
# Example: CORS=https://myapp.example.com,https://admin.example.com
CORS=


# ── Web App (development only) ────────────────────

# Hostname the frontend uses to reach the server (dev mode only).
# In production the frontend is served from the same origin as the server.
# Default: localhost
VITE_DIVEEOI_SERVER_HOST=localhost

# Port the frontend uses to reach the server (dev mode only).
# Default: 4097
VITE_DIVEEOI_SERVER_PORT=4097

# Password-gated authentication (optional).
# Leave empty to disable authentication.
VITE_DIVEEOI_SERVER_PASSWORD=
VITE_DIVEEOI_SERVER_USERNAME=opencode
