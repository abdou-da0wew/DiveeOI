{
  "name": "diveeoi",
  "description": "AI-powered development web app - fork of OpenCode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --cwd packages/server dev",
    "dev:watch": "bun --cwd packages/server dev:watch",
    "dev:web": "bun --cwd packages/app dev",
    "dev:both": "concurrently --names server,app --prefix-colors cyan,green \"bun --cwd packages/server dev:watch\" \"bun --cwd packages/app dev\"",
    "build": "bun turbo build",
    "typecheck": "bun turbo typecheck",
    "lint": "oxlint",
    "clean": "rm -rf packages/*/dist packages/*/.turbo"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.74",
      "@effect/platform-node": "4.0.0-beta.74",
      "@effect/sql-sqlite-bun": "4.0.0-beta.74",
      "@types/bun": "1.3.13",
      "@npmcli/arborist": "9.4.0",
      "@types/node": "24.12.2",
      "@types/cross-spawn": "6.0.6",
      "@types/luxon": "3.7.1",
      "@types/semver": "7.7.1",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@octokit/rest": "22.0.0",
      "@playwright/test": "1.59.1",
      "@opentui/core": "0.3.4",
      "@opentui/keymap": "0.3.4",
      "@opentui/solid": "0.3.4",
      "@kobalte/core": "0.13.11",
      "@tanstack/solid-virtual": "3.13.28",
      "@shikijs/stream": "4.2.0",
      "drizzle-orm": "1.0.0-rc.2",
      "drizzle-kit": "1.0.0-rc.2",
      "effect": "4.0.0-beta.74",
      "ai": "6.0.168",
      "hono": "4.10.7",
      "solid-js": "1.9.10",
      "vite": "7.1.4",
      "typescript": "5.8.2",
      "zod": "4.1.8",
      "tailwindcss": "4.1.11",
      "shiki": "4.2.0",
      "@silvia-odwyer/photon-node": "0.3.4",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "solid-list": "0.3.0",
      "opentui-spinner": "0.0.7",
      "semver": "7.7.4",
      "@pierre/diffs": "1.2.10",
      "ulid": "3.0.1",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "vite-plugin-solid": "2.11.10",
      "cross-spawn": "7.0.6",
      "@tailwindcss/vite": "4.1.11",
      "@solid-primitives/storage": "4.3.3",
      "@lydell/node-pty": "1.2.0-beta.12",
      "hono-openapi": "1.1.2",
      "@hono/standard-validator": "0.2.0",
      "@hono/zod-validator": "0.4.2",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "dompurify": "3.3.1",
      "diff": "8.0.2"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "concurrently": "10.0.3",
    "prettier": "3.6.2",
    "turbo": "2.8.13"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "@tanstack/solid-virtual@3.13.28": "patches/@tanstack%2Fsolid-virtual@3.13.28.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "@tanstack/virtual-core@3.17.0": "patches/@tanstack%2Fvirtual-core@3.17.0.patch",
    "effect@4.0.0-beta.74": "patches/effect@4.0.0-beta.74.patch",
    "@ff-labs/fff-bun@0.9.3": "patches/@ff-labs%2Ffff-bun@0.9.3.patch",
    "@ai-sdk/xai@3.0.82": "patches/@ai-sdk%2Fxai@3.0.82.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch"
  }
}
