{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "DIVEEOI_BUILD_SINGLE", "DIVEEOI_BUILD_NOBINARY", "DIVEEOI_BUILD_OS", "DIVEEOI_BUILD_ARCH", "DIVEEOI_LOW_MEM"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "typecheck": {},
    "@diveeoi/app#build": {
      "dependsOn": ["@diveeoi/sdk#build"],
      "outputs": ["dist/**"]
    },
    "@diveeoi/server#build": {
      "dependsOn": ["@diveeoi/app#build"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    }
  }
}
