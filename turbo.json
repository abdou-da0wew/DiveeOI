{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "typecheck": {},
    "@diveeoi/app#build": {
      "dependsOn": ["@diveeoi/sdk#build"],
      "outputs": ["dist/**"]
    },
    "@diveeoi/server#build": {
      "dependsOn": ["@diveeoi/app#build"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    }
  }
}
