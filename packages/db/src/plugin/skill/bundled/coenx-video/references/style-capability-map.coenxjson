    {
      "part": "Easing as a number",
      "example": "Snaps use cubic-bezier(.7,0,.2,1). Not \"smooth\"."
    },
    {
      "part": "Timing as frames",
      "example": "Groups stagger by 3 frames. Morphs take 18 to 30."
    },
