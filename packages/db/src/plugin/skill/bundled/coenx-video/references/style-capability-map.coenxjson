  "anatomy": [
    {
      "part": "Medium in one clause",
      "example": "Risograph print, two spot inks on warm paper."
    },
    {
      "part": "Palette with hex codes",
      "example": "Off-white #f5f2ea, black #111, one red #e63323."
    },
    {
      "part": "Colour logic",
      "example": "Only one element carries the signal colour per shot."
